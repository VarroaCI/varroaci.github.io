---
import { Image } from "astro:assets";
import ogImage from "../assets/og-image.png";
import dashboardShot from "../assets/dashboard.webp";
import controllersShot from "../assets/controllers.webp";
import detailShot from "../assets/controller-detail.webp";
// src/pages/index.astro — the varroa.dev brochure landing page. Frozen
// section order: (1) hero, (2) the three products, (3) MCP showcase +
// screenshot, (4) screenshot gallery, (5) CloudBees teaser, (6) footer. Order
// is enforced by scripts/check-section-order.mjs, not by this comment. The
// brochure carries no scale figures and no internal Varroa jargon.
import "../styles/tokens.css";
import SiteBackdrop from "../components/SiteBackdrop.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import Analytics from "../components/Analytics.astro";
import McpShowcase from "../components/McpShowcase.astro";

const products = [
  {
    title: "Pipelines",
    body: "Push a Jenkinsfile and get builds, logs, and artifacts on a page that is always there. A build keeps going even when the Jenkins behind it is gone.",
    link: { label: "Read and run pipelines", href: "/docs/tutorials/pipelines/" },
  },
  {
    title: "Classic Jenkins",
    body: "A Jenkins of your own, with its home, plugins, and configuration. Varroa provisions it, signs you in, and puts it to sleep when idle.",
    link: { label: "Your first controller", href: "/docs/tutorials/first-controller/" },
  },
  {
    title: "AI agents",
    body: "Bring your own agent, or use the assistant in the dashboard. Every action runs as you, with your permissions.",
    link: { label: "Agents", href: "/agents/" },
  },
];
---

<html lang="en" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>Varroa: Jenkins has evolved</title>
    <meta
      name="description"
      content="GitHub Actions-style pipelines on a stateless Jenkins engine, classic Jenkins controllers as Kubernetes resources, and one MCP endpoint for AI agents."
    />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Varroa" />
    <meta property="og:title" content={"Varroa: Jenkins has evolved"} />
    <meta property="og:description" content={"GitHub Actions-style pipelines on a stateless Jenkins engine, classic controllers as Kubernetes resources, and one MCP endpoint for AI agents."} />
    <meta property="og:url" content={new URL("/", Astro.site).href} />
    <meta property="og:image" content={new URL(ogImage.src, Astro.site).href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={"Varroa: Jenkins has evolved"} />
    <meta name="twitter:description" content={"GitHub Actions-style pipelines on a stateless Jenkins engine, classic controllers as Kubernetes resources, and one MCP endpoint for AI agents."} />
    <meta name="twitter:image" content={new URL(ogImage.src, Astro.site).href} />
    <script>
      // Default first-time visitors to dark theme, mirroring the Starlight
      // head-script default in astro.config.mjs (see task 2.1/4.1). Only
      // writes the storage key when absent, so a saved choice is never
      // overwritten.
      (function () {
        try {
          var stored = localStorage.getItem("starlight-theme");
          var theme = stored || "dark";
          document.documentElement.dataset.theme = theme;
          if (!stored) localStorage.setItem("starlight-theme", "dark");
        } catch (e) {
          // Storage inaccessible — the dark default set on <html> above holds.
        }
      })();
    </script>
    <Analytics />
  </head>
  <body class="varroa-brochure">
    <SiteBackdrop />
    <SiteHeader />

    <main>
      <!-- (1) Hero -->
      <section class="varroa-shell varroa-hero">
        <h1>Jenkins has evolved.</h1>
        <p class="varroa-hero__sub">
          Run Jenkinsfiles the way GitHub Actions runs workflows, with no Jenkins server to run, back up, or restart.
          Or run a classic Jenkins that is yours alone.
        </p>
        <div class="varroa-hero__ctas">
          <a class="varroa-cta varroa-cta--primary" href="/docs/install/prerequisites/">Get started</a>
          <a class="varroa-cta varroa-cta--secondary" href="https://github.com/VarroaCI/varroa-jenkins">View on GitHub</a>
        </div>
      </section>

      <!-- (2) The three products -->
      <section class="varroa-shell varroa-products" aria-labelledby="products-heading">
        <h2 id="products-heading" class="varroa-visually-hidden">What Varroa runs</h2>
        <ul class="varroa-products__grid">
          {products.map((product) => (
            <li class="varroa-product">
              <h3>{product.title}</h3>
              <p>{product.body}</p>
              <p class="varroa-product__links">
                <a href={product.link.href}>{product.link.label}</a>
              </p>
            </li>
          ))}
        </ul>
      </section>

      <!-- (3) MCP showcase + screenshot -->
      <section class="varroa-shell varroa-mcp" aria-labelledby="mcp-heading">
        <h2 id="mcp-heading">Drive the fleet with an AI agent</h2>
        <p class="varroa-mcp__intro">
          One agent session: it stands up a Jenkins, runs a job, and reads the result.
        </p>
        <McpShowcase />
        <figure class="varroa-shots">
          <button
            type="button"
            class="varroa-shots__frame"
            data-lightbox-open
            data-lightbox-src={dashboardShot.src}
            data-lightbox-alt="Varroa dashboard, full size: a phase bar for six Jenkins controllers across three namespaces, a short list of controllers that need a look, and a recent activity feed."
            aria-label="Expand the dashboard screenshot"
          >
          <Image
            src={dashboardShot}
            alt="Varroa dashboard showing a fleet overview: a phase bar for six Jenkins controllers across three namespaces, a short list of controllers that need a look, and a recent activity feed."
            widths={[720, 1080, 1440]}
            sizes="(min-width: 60rem) 60rem, 100vw"
            loading="lazy"
          />
          </button>
          <figcaption>
            The fleet overview: the phase of every controller, the controllers that need a look, and recent activity in one place.{" "}
            <span class="varroa-shots__hint">Tap to expand.</span>
          </figcaption>
        </figure>

        <dialog class="varroa-lightbox" data-lightbox aria-label="Screenshot, expanded">
          <form method="dialog" class="varroa-lightbox__close-form">
            <button class="varroa-lightbox__close" aria-label="Close">&#215;</button>
          </form>
          <img data-lightbox-img src={dashboardShot.src} alt="" />
        </dialog>
      </section>

      <!-- (4) Fleet and audit screenshots -->
      <section class="varroa-shell varroa-gallery" aria-labelledby="gallery-heading">
        <h2 id="gallery-heading" class="varroa-gallery__heading">Every controller, and everything that happened to it</h2>
        <div class="varroa-gallery__grid">
          <figure class="varroa-shots">
            <button
              type="button"
              class="varroa-shots__frame"
              data-lightbox-open
              data-lightbox-src={controllersShot.src}
              data-lightbox-alt="The Varroa controllers table, full size: five controllers across two clusters in connected, provisioning, and hibernated phases, with version and connection state."
              aria-label="Expand the controllers screenshot"
            >
              <Image
                src={controllersShot}
                alt="The Varroa controllers table: five controllers across two clusters, showing connected, provisioning, and hibernated phases."
                widths={[480, 720, 1080]}
                sizes="(min-width: 60rem) 30rem, 100vw"
                loading="lazy"
              />
            </button>
            <figcaption>
              One table for the fleet, across clusters and phases.{" "}
              <span class="varroa-shots__hint">Tap to expand.</span>
            </figcaption>
          </figure>

          <figure class="varroa-shots">
            <button
              type="button"
              class="varroa-shots__frame"
              data-lightbox-open
              data-lightbox-src={detailShot.src}
              data-lightbox-alt="A single Varroa controller page, full size: bundle, apply, and Jenkins status across the top, followed by its activity history and spec."
              aria-label="Expand the controller detail screenshot"
            >
              <Image
                src={detailShot}
                alt="A single Varroa controller: bundle, apply, and Jenkins status, with its activity history below."
                widths={[480, 720, 1080]}
                sizes="(min-width: 60rem) 30rem, 100vw"
                loading="lazy"
              />
            </button>
            <figcaption>
              One controller in depth: what it should run, what was applied, and what Jenkins reports.{" "}
              <span class="varroa-shots__hint">Tap to expand.</span>
            </figcaption>
          </figure>
        </div>
      </section>

      <!-- (5) CloudBees teaser -->
      <section class="varroa-shell varroa-teaser" aria-labelledby="teaser-heading">
        <h2 id="teaser-heading">Already running CloudBees CI?</h2>
        <p>
          See how Varroa's CRD-native controllers, bundles, and RBAC federation line up against CloudBees CI, and what changes if you
          migrate.
        </p>
        <a class="varroa-cta varroa-cta--secondary" href="/compare/">Compare Varroa to CloudBees CI</a>
      </section>
    </main>

    <SiteFooter />
  </body>
</html>

<script>
  // Native <dialog> lightbox: Esc-to-close and focus trapping come free.
  const dialog = document.querySelector("[data-lightbox]");
  const image = document.querySelector("[data-lightbox-img]");
  const openers = document.querySelectorAll("[data-lightbox-open]");
  if (dialog instanceof HTMLDialogElement && image instanceof HTMLImageElement) {
    for (const opener of openers) {
      opener.addEventListener("click", () => {
        image.src = opener.dataset.lightboxSrc ?? "";
        image.alt = opener.dataset.lightboxAlt ?? "";
        dialog.showModal();
        // When the image is wider than the dialog (phones pan rather than
        // shrink), start centred on the content, not pinned to the sidebar.
        const centre = () => {
          const overflow = dialog.scrollWidth - dialog.clientWidth;
          if (overflow > 0) dialog.scrollLeft = overflow / 2;
        };
        image.complete ? centre() : image.addEventListener("load", centre, { once: true });
      });
    }
    // Clicking the backdrop closes: the dialog element's own box is the
    // backdrop hit area, so only a click outside the image should dismiss.
    dialog.addEventListener("click", (event) => {
      if (event.target === dialog) dialog.close();
    });
  }
</script>

<style>
  .varroa-hero {
    padding-block: 4rem 3rem;
  }

  .varroa-hero h1 {
    font-size: clamp(2rem, 4.5vw, 3rem);
    line-height: 1.15;
    margin: 0 0 1.25rem;
    max-width: 44rem;
  }

  .varroa-hero__sub {
    max-width: 42rem;
    color: var(--varroa-text-dim);
    font-size: 1.1rem;
    margin: 0 0 1.25rem;
  }


  .varroa-hero__ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
  }


  .varroa-products {
    padding-block: 1rem 3rem;
  }

  .varroa-products__grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 1.5rem;
    grid-template-columns: 1fr;
  }

  @media (min-width: 60rem) {
    .varroa-products__grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .varroa-product {
    padding: 1.5rem;
    border: 1px solid var(--varroa-border);
    border-radius: 0.5rem;
    background: var(--varroa-bg-raised);
  }

  .varroa-product h3 {
    margin: 0 0 0.75rem;
    font-size: 1.15rem;
    color: var(--varroa-accent-high);
  }

  .varroa-product p {
    margin: 0 0 0.75rem;
    color: var(--varroa-text-dim);
    font-size: 0.95rem;
  }

  .varroa-product p.varroa-product__links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.25rem;
    margin-bottom: 0;
  }

  .varroa-mcp {
    padding-block: 2rem 3rem;
    border-top: 1px solid var(--varroa-border);
  }

  .varroa-mcp__intro {
    max-width: 46rem;
    color: var(--varroa-text-dim);
    margin: 0.5rem 0 2rem;
  }

  .varroa-shots {
    margin: 2.5rem 0 0;
  }

  .varroa-shots__frame {
    display: block;
    width: 100%;
    cursor: zoom-in;
    appearance: none;
    font: inherit;
    color: inherit;
    text-align: inherit;
    padding: 0.75rem;
    background: var(--varroa-shot-frame);
    border: 1px solid var(--varroa-shot-frame-border);
    border-radius: 12px;
  }

  .varroa-shots img {
    display: block;
    width: 100%;
    max-width: 100%;
    height: auto;
    border-radius: 6px;
  }

  .varroa-shots__hint {
    white-space: nowrap;
  }

  .varroa-lightbox {
    padding: 0;
    border: 1px solid var(--varroa-shot-frame-border);
    border-radius: 12px;
    background: var(--varroa-shot-frame);
    max-width: min(96vw, 1600px);
    max-height: 92vh;
    overflow: auto;
    overscroll-behavior: contain;
  }

  .varroa-lightbox::backdrop {
    background: rgb(0 0 0 / 0.72);
  }

  .varroa-lightbox img {
    display: block;
    width: 100%;
    height: auto;
    max-height: 92vh;
    object-fit: contain;
  }

  /* On a phone, fitting a 2160px dashboard into ~360px makes it unreadable.
     Render it large enough to read and let the dialog pan instead. */
  @media (max-width: 48rem) {
    .varroa-lightbox img {
      width: 760px;
      max-width: none;
      max-height: none;
    }
  }

  .varroa-lightbox__close-form {
    position: fixed;
    top: 1rem;
    right: 1rem;
    margin: 0;
    z-index: 1;
  }

  .varroa-lightbox__close {
    width: 2.25rem;
    height: 2.25rem;
    font-size: 1.4rem;
    line-height: 1;
    cursor: pointer;
    color: #f4efe6;
    background: rgb(0 0 0 / 0.55);
    border: 1px solid var(--varroa-shot-frame-border);
    border-radius: 999px;
  }

  .varroa-lightbox__close:hover {
    background: rgb(0 0 0 / 0.8);
  }

  .varroa-shots figcaption {
    margin-top: 0.75rem;
    font-size: 0.9rem;
    color: var(--varroa-text-dim);
  }

  .varroa-gallery {
    padding-block: 1rem 2rem;
  }

  .varroa-gallery__heading {
    font-size: 1.35rem;
    margin: 0 0 1.5rem;
  }

  .varroa-gallery__grid {
    display: grid;
    gap: 1.5rem;
    grid-template-columns: 1fr;
  }

  @media (min-width: 60rem) {
    .varroa-gallery__grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  .varroa-gallery .varroa-shots {
    margin: 0;
  }

  .varroa-teaser {
    padding-block: 2rem 4rem;
    border-top: 1px solid var(--varroa-border);
  }

  .varroa-teaser p {
    max-width: 40rem;
    color: var(--varroa-text-dim);
    margin: 0.5rem 0 1.5rem;
  }

  .varroa-visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }
</style>
